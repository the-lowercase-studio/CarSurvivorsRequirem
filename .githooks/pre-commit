#!/bin/sh
set -e

if git diff --cached --quiet; then
    exit 0
fi

if ! command -v powershell.exe >/dev/null 2>&1; then
    echo "ERROR: powershell.exe is required to run .agents/scripts/verify-change.ps1" >&2
    exit 1
fi

exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File ".agents/scripts/verify-change.ps1" -StagedOnly
